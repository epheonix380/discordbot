# Environment variables for Discord Bot with Django REST API
# Requires Python 3.13+ for optimal asyncio performance

# Discord Bot Configuration
TOKEN=your_discord_bot_token_here

# Django Configuration
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=your_django_secret_key_here

# Database Configuration
POSTGRES_DB=discord_bot
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
# For production, you can also use DATABASE_URL instead:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# API Configuration
DJANGO_API_URL=http://localhost:8000
API_PORT=8000

# Spotify Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback/
SPOTIFY_DEVICE_NAME=Discord Bot

# Server Configuration
API_HOST=0.0.0.0

# Note: librespot-python is installed from GitHub, not PyPI:
# pip install git+https://github.com/kokarare1212/librespot-python.git
# 
# Important: librespot-python requires protobuf==3.20.1 (pinned in requirements)
